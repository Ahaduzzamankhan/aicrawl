{
  "version": "1",
  "url": "https://books.toscrape.com/",
  "action": "extract",
  "render": "off",
  "selectors": {
    "products": {
      "type": "list",
      "selector": "article.product_pod",
      "fields": {
        "title": { "selector": "h3 a", "attribute": "title", "required": true },
        "price": { "selector": ".price_color", "type": "number" },
        "availability": { "selector": ".availability" },
        "link": { "selector": "h3 a", "type": "url" },
        "image": { "selector": "img", "attribute": "src", "type": "url" }
      }
    }
  },
  "pagination": {
    "enabled": true,
    "next_selector": "li.next a",
    "max_pages": 3
  },
  "deduplicate": { "enabled": true, "keys": ["title"] },
  "output": { "format": "json", "pretty": true }
}
