{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicrawl.dev/schemas/crawl-request.schema.json",
  "title": "AICrawl crawl request",
  "description": "Body for POST /api/v1/crawl and the MCP crawl_website tool.",
  "type": "object",
  "required": ["url"],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Starting URL. Must be http or https."
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 10
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 2
    },
    "query": {
      "type": "string",
      "description": "Optional extraction query applied to every crawled page."
    },
    "render": {
      "type": "boolean",
      "default": false
    },
    "same_domain": {
      "type": "boolean",
      "default": true
    }
  }
}
